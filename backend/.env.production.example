# ==============================================================================
# INDRADHANU CLIMATE ADVISORY - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
APP_NAME=Indradhanu
VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# Database (Supabase PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & JWT Validation
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_JWT_SECRET=[YOUR-SUPABASE-JWT-SECRET]

# CORS Allowed Origins
CORS_ORIGINS=["https://indradhanu.app","https://admin.indradhanu.app"]

# Climate Intelligence API (Open-Meteo High-Resolution Ensemble)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal

# AI Advisory Generation (Gemini API)
GEMINI_API_KEY=[YOUR-GOOGLE-GEMINI-API-KEY]
GEMINI_MODEL=gemini-1.5-flash

# Channel 1: MSG91 SMS Provider (India DLT Compliant)
MSG91_AUTH_KEY=[YOUR-MSG91-AUTH-KEY]
MSG91_SENDER_ID=[YOUR-6-CHAR-SENDER-ID]
MSG91_DLT_TEMPLATE_ID=[YOUR-DLT-TEMPLATE-ID]

# Channel 2: Exotel Voice IVR & Call Flow
EXOTEL_ACCOUNT_SID=[YOUR-EXOTEL-ACCOUNT-SID]
EXOTEL_API_KEY=[YOUR-EXOTEL-API-KEY]
EXOTEL_API_TOKEN=[YOUR-EXOTEL-API-TOKEN]
EXOTEL_CALLER_ID=[YOUR-EXOTEL-VIRTUAL-NUMBER]
EXOTEL_APP_ID=[YOUR-EXOTEL-FLOW-APP-ID]

# Channel 3: Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=[YOUR-PHONE-NUMBER-ID]
WHATSAPP_BUSINESS_ACCOUNT_ID=[YOUR-WABA-ID]
WHATSAPP_ACCESS_TOKEN=[YOUR-SYSTEM-USER-PERMANENT-TOKEN]
WHATSAPP_WEBHOOK_VERIFY_TOKEN=[YOUR-ARBITRARY-VERIFICATION-TOKEN]

# Telemetry, Simulation & Operational Flags
SIMULATE_DELIVERIES=false
RATE_LIMIT_ADVISORIES_PER_DAY=3
IDEMPOTENCY_WINDOW_SECONDS=3600

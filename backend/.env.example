# ==============================================================================
# Indradhanu Backend Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
APP_NAME="Indradhanu Climate Advisory API"
API_V1_STR="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Supabase / PostgreSQL Database Connection
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# For Supabase Session Mode Pooler (Port 5432):
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"

# Sync Database URL for Alembic Migrations
# Format: postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
SYNC_DATABASE_URL="postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"

# Supabase Auth & JWT Configuration (Project Settings -> API -> JWT Settings)
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET_FROM_DASHBOARD"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

# External API Placeholders (Prepared for future integration phases)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID_HERE"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN_HERE"
TWILIO_PHONE_NUMBER="YOUR_TWILIO_PHONE_NUMBER_HERE"


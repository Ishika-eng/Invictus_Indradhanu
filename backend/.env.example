# ==============================================================================
# Indradhanu Backend Environment Configuration (.env.example)
# Exact variable names matched directly to app.core.config.Settings
# ==============================================================================

# Application & Runtime
ENVIRONMENT=development
DEBUG=true
APP_NAME="Indradhanu Climate Advisory API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (comma-separated or JSON array)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8081,http://127.0.0.1:8081"

# Database Connection Settings (PostgreSQL with asyncpg & psycopg)
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"
SYNC_DATABASE_URL="postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

# Supabase Auth & JWT Configuration
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Climate Telemetry APIs (Open-Meteo & NASA POWER)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal"

# AI Advisory Generation (Gemini 1.5 Flash)
GEMINI_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"
GEMINI_MODEL="gemini-1.5-flash"

# Stage 6: Multichannel Advisory Communication Settings ("SIMULATION" or "LIVE")
COMMUNICATION_MODE="SIMULATION"

# Channel 1: SMS (MSG91 & Indian DLT Distributed Ledger Technology)
MSG91_AUTH_KEY="YOUR_MSG91_AUTH_KEY"
MSG91_SENDER_ID="INDRDH"
MSG91_DLT_TE_ID="YOUR_DLT_TEMPLATE_ID"

# Channel 2: Voice IVR (Exotel & Multilingual TTS)
EXOTEL_API_KEY="YOUR_EXOTEL_API_KEY"
EXOTEL_API_TOKEN="YOUR_EXOTEL_API_TOKEN"
EXOTEL_SUBDOMAIN="api.exotel.com"
EXOTEL_CALLER_ID="YOUR_EXOTEL_VIRTUAL_NUMBER"
EXOTEL_APP_ID="YOUR_EXOTEL_APP_ID"

# Channel 3: WhatsApp (Meta Cloud API)
META_WHATSAPP_TOKEN="YOUR_META_SYSTEM_USER_TOKEN"
META_WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"
META_WHATSAPP_VERIFY_TOKEN="indradhanu_secure_webhook_verify_token"
META_WHATSAPP_APP_SECRET="YOUR_META_APP_SECRET"

# Legacy Twilio Credentials (Optional development fallback)
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="YOUR_TWILIO_PHONE_NUMBER"

# Stage 7: Admin & Operator Governance Key
ADMIN_SECRET_KEY="indradhanu_admin_super_secret_key_2026"
